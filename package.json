{
  "name": "astro-strapi-vitrine",
  "type": "module",
  "version": "1.0.0",
  "description": "Boilerplate sites vitrines : Astro 7 + Strapi 5, TypeScript, Tailwind 4, SEO-first, RGPD. Piloté par Claude Code.",
  "private": true,
  "scripts": {
    "postinstall": "npm --prefix backend install && node scripts/copy-tarteaucitron.mjs",
    "setup": "node scripts/init-project.mjs",
    "dev": "concurrently -n cms,web -c magenta,cyan -k \"npm:dev:cms\" \"npm:dev:web\"",
    "dev:cms": "npm --prefix backend run develop",
    "dev:web": "astro dev",
    "start": "npm run dev",
    "build": "npm run build:cms && npm run build:web",
    "build:cms": "npm --prefix backend run build",
    "build:web": "astro check && astro build",
    "preview": "astro preview",
    "typecheck": "astro check",
    "cms:start": "npm --prefix backend run start",
    "cms:seed": "SEED_FORCE=true npm --prefix backend run develop",
    "skills:refresh": "node scripts/refresh-skills.mjs",
    "astro": "astro"
  },
  "dependencies": {
    "@astrojs/check": "0.9.9",
    "@astrojs/react": "6.0.1",
    "@astrojs/sitemap": "3.7.3",
    "@fontsource-variable/inter": "^5.3.0",
    "@sensinum/astro-strapi-blocks": "^1.5.0",
    "@sensinum/astro-strapi-loader": "^1.4.0",
    "@tailwindcss/vite": "^4.3.3",
    "astro": "7.1.3",
    "astro-icon": "^1.2.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lodash": "^4.18.1",
    "lucide-react": "^0.576.0",
    "motion": "^14.5.0",
    "qs": "^6.15.3",
    "radix-ui": "^1.6.7",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "slugify": "^1.6.9",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.3",
    "tarteaucitronjs": "^1.37.0",
    "typescript": "^5.7.2"
  },
  "devDependencies": {
    "@iconify-json/lucide": "^1.2.147",
    "@iconify-json/simple-icons": "^1.2.0",
    "@types/lodash": "^4.17.13",
    "@types/qs": "^6.15.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.0.2",
    "concurrently": "^10.0.6",
    "schema-dts": "^2.1.0",
    "shadcn": "^3.8.5",
    "tw-animate-css": "^1.4.0"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
