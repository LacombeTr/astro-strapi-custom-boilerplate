# ─────────────────────────────────────────────────────────────────────────────
# Front Astro — copier ce fichier en `.env` (fait automatiquement par `npm run setup`)
# ─────────────────────────────────────────────────────────────────────────────

# URL du CMS Strapi. En local, le backend du monorepo écoute sur ce port.
STRAPI_URL=http://localhost:1337

# Token API en lecture seule, utilisé au build pour lire le contenu.
# Laissé vide : rempli automatiquement au premier `npm run dev` par l'amorçage du CMS
# (backend/src/seed.ts). En production, créez-le depuis l'admin Strapi :
# Settings → API Tokens, et donnez-lui find/findOne + Content-Type Builder en lecture.
STRAPI_TOKEN=

# ─────────────────────────────────────────────────────────────────────────────
# Mesure d'audience (optionnel)
# ─────────────────────────────────────────────────────────────────────────────

# Identifiant Google Analytics 4, au format G-XXXXXXXXXX.
# Laissé vide : aucun script de mesure n'est chargé et AUCUN bandeau cookies n'est affiché.
# Renseigné : GA4 est proposé via tarteaucitron et ne se charge qu'après consentement.
PUBLIC_GA_ID=
