---
/**
 * En-tête du site. Nom, logo et menu viennent du single type « Réglages du site » de Strapi,
 * afin que le client puisse modifier sa navigation sans intervention sur le code.
 *
 * Tout est en repli : si le CMS est injoignable, on affiche le nom issu de `site.ts` et un
 * menu vide plutôt qu'une page cassée.
 */
import { Icon } from 'astro-icon/components';

import ThemeToggle from './ThemeToggle.astro';
import { site } from '../config/site';
import { buildMediaUrl } from '../utils/media';
import type { StrapiGlobal } from '../types/strapi';

type Props = { global?: StrapiGlobal | null };

const { global = null } = Astro.props;

const siteName = global?.siteName ?? site.name;
const logoUrl = global?.logo?.url ? buildMediaUrl(global.logo.url) : null;
const navigation = global?.navigation ?? [];
const currentPath = Astro.url.pathname;

/** Compare en ignorant le slash final, pour que « /contact » et « /contact/ » concordent. */
const isCurrent = (url: string) =>
  currentPath.replace(/\/$/, '') === url.replace(/\/$/, '');
---

<header class="sticky top-0 z-50 border-b border-border bg-background/80 backdrop-blur">
  <div class="mx-auto flex h-16 max-w-screen-xl items-center justify-between px-4 sm:px-6 lg:px-8">
    <a href="/" class="flex items-center gap-2 font-semibold transition-opacity hover:opacity-80">
      {
        logoUrl ? (
          <img src={logoUrl} alt={siteName} class="h-8 w-auto" width="32" height="32" />
        ) : (
          <span class="text-lg">{siteName}</span>
        )
      }
    </a>

    <div class="flex items-center gap-2">
      <nav aria-label="Navigation principale" class="hidden sm:block">
        <ul class="flex items-center gap-1">
          {
            navigation.map((item) => (
              <li>
                <a
                  href={item.url}
                  target={item.openInNewTab ? '_blank' : undefined}
                  rel={item.openInNewTab ? 'noopener noreferrer' : undefined}
                  aria-current={isCurrent(item.url) ? 'page' : undefined}
                  class="rounded-md px-3 py-2 text-sm text-muted-foreground transition-colors hover:bg-muted hover:text-foreground aria-[current=page]:text-foreground aria-[current=page]:font-medium"
                >
                  {item.label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>

      <ThemeToggle />

      {/* Menu mobile : <details> donne un repli accessible sans une ligne de JavaScript. */}
      {
        navigation.length > 0 && (
          <details class="relative sm:hidden">
            <summary
              class="inline-flex size-9 cursor-pointer list-none items-center justify-center rounded-md border border-border transition-colors hover:bg-muted"
              aria-label="Ouvrir le menu"
            >
              <Icon name="lucide:menu" class="size-4" />
            </summary>
            <nav
              aria-label="Navigation principale"
              class="absolute right-0 mt-2 w-48 rounded-lg border border-border bg-background p-2 shadow-lg"
            >
              <ul class="flex flex-col">
                {navigation.map((item) => (
                  <li>
                    <a
                      href={item.url}
                      target={item.openInNewTab ? '_blank' : undefined}
                      rel={item.openInNewTab ? 'noopener noreferrer' : undefined}
                      aria-current={isCurrent(item.url) ? 'page' : undefined}
                      class="block rounded-md px-3 py-2 text-sm transition-colors hover:bg-muted"
                    >
                      {item.label}
                    </a>
                  </li>
                ))}
              </ul>
            </nav>
          </details>
        )
      }
    </div>
  </div>
</header>
