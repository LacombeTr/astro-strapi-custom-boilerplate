---
/**
 * Bandeau d'en-tête de page (composant Strapi `blocks.hero`).
 *
 * Contraintes SEO et performance assumées ici :
 *  - un seul <h1> par page, et c'est celui-ci ;
 *  - l'image de fond porte `width`/`height` et `fetchpriority="eager"` : c'est l'élément
 *    LCP de la page, et des dimensions explicites évitent tout décalage de mise en page ;
 *  - aucune dépendance JavaScript.
 */
import { StrapiBlocks } from '@sensinum/astro-strapi-blocks';

import type { StrapiBlockField, StrapiContentHeroComponent } from '../../types/strapi';
import { buildMediaUrl } from '../../utils';

type Props = {
	data: StrapiContentHeroComponent;
	/**
	 * `false` sur les pages où le hero n'est pas le titre principal : le titre devient alors
	 * un <p> stylé, pour ne pas créer un second <h1>.
	 */
	heading?: boolean;
};

const { data, heading = true } = Astro.props;

const background = data.background;
---

<section class="relative overflow-hidden py-20 sm:py-24 lg:py-32">
	{
		background && (
			<div class="absolute inset-0 z-0">
				<img
					src={buildMediaUrl(background.url)}
					alt={background.alternativeText || ''}
					width={background.width}
					height={background.height}
					loading="eager"
					fetchpriority="high"
					decoding="async"
					class="h-full w-full object-cover opacity-25 dark:opacity-20"
				/>
				{/* Voile de contraste : sans lui, le texte devient illisible sur certaines photos. */}
				<div class="absolute inset-0 bg-background/60 dark:bg-background/70" />
			</div>
		)
	}

	<div class="relative z-10 mx-auto max-w-screen-xl px-4 sm:px-6 lg:px-8">
		<div class="mx-auto max-w-3xl text-center" data-reveal>
			{
				heading ? (
					<h1 class="text-4xl font-bold leading-tight tracking-tight text-balance sm:text-5xl lg:text-6xl">
						{data.title}
					</h1>
				) : (
					<p class="text-3xl font-bold leading-tight tracking-tight text-balance sm:text-4xl">
						{data.title}
					</p>
				)
			}

			{
				data.subtitle && (
					<p class="mt-6 text-lg font-light text-pretty text-muted-foreground sm:text-xl">
						{data.subtitle}
					</p>
				)
			}

			{
				data.content && (
					<StrapiBlocks
						class="mt-6 text-base text-pretty text-muted-foreground"
						data={data.content as StrapiBlockField}
					/>
				)
			}

			{
				data.cta && (
					<div class="mt-10 flex flex-wrap justify-center gap-4">
						<a
							href={data.cta.url}
							class="inline-flex items-center gap-2 rounded-xl bg-primary px-8 py-3 text-lg font-semibold text-primary-foreground shadow-lg shadow-primary/25 transition-all hover:-translate-y-0.5 hover:bg-primary/90"
						>
							{data.cta.label}
						</a>
					</div>
				)
			}
		</div>
	</div>
</section>
